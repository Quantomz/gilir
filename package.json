{
  "name": "gilir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run test && npm run check:boundaries"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@turf/area": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/point-on-feature": "7.4.0",
    "idb": "8.0.4",
    "maplibre-gl": "6.18.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
